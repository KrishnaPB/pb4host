# Copy to .env — never commit the real file. Everything here is read by prospector.config.Settings.
ENVIRONMENT=development
# SQLite for local development; the docker-compose stack overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./data/prospector.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Separate salt for suppression-list hashes (HMAC-SHA256). Changing it invalidates the list.
SUPPRESSION_SALT=change-me-too
DATA_DIR=./data
BASE_URL=http://localhost:8000
# Optional bearer token for the JSON API (header X-API-Key)
API_TOKEN=
LOG_LEVEL=INFO

# --- Business identity used in notice text -------------------------------------------------
BUSINESS_NAME=PB4HOST
NOTICE_CONTACT_EMAIL=privacy@pb4host.com

# --- Connectors (all disabled until keys are set and terms reviewed in Admin → Connectors) --
GOOGLE_MAPS_API_KEY=
PSI_API_KEY=
PLACES_REGION_CODE=IN
PLACES_LANGUAGE_CODE=en
PLACES_PAGES_PER_RUN=10
PSI_RUNS=1
PSI_STRATEGIES=["mobile"]

# --- Crawler conduct (R11) -------------------------------------------------------------------
CRAWLER_USER_AGENT=PB4HOST-Prospector/0.1 (+https://www.pb4host.com/prospector; prospector@pb4host.com)
CRAWLER_POLICY_URL=https://www.pb4host.com/prospector
CRAWLER_MIN_INTERVAL_S=1.0
CRAWLER_TIMEOUT_S=10
CRAWLER_MAX_BYTES=2000000
CRAWLER_MAX_PAGES=6
CRAWLER_ACTIVE_PROBES=false

# --- Retention (days) ------------------------------------------------------------------------
RETENTION_RAW_DAYS=30
RETENTION_COORDS_DAYS=30
RETENTION_PERF_DAYS=365
RETENTION_UNENGAGED_DAYS=365
RETENTION_PERSON_DAYS=180
RETENTION_JOBS_DAYS=30
TERMS_REVIEW_MAX_AGE_DAYS=90

# --- Scoring context ------------------------------------------------------------------------
LATEST_WORDPRESS_VERSION=6.8
PHP_MIN_SUPPORTED=8.2

# --- docker-compose only --------------------------------------------------------------------
POSTGRES_PASSWORD=
PROSPECTOR_HOST=prospector.example.com
ADMIN_EMAIL=admin@example.com
BACKUP_KEEP_DAYS=14
