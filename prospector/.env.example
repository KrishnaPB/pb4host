# Copy to .env — never commit the real file. Everything here is read by prospector.config.Settings.
ENVIRONMENT=development
# SQLite for local development; the docker-compose stack overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./data/prospector.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Separate salt for suppression-list hashes (HMAC-SHA256). Changing it invalidates the list.
SUPPRESSION_SALT=change-me-too
DATA_DIR=./data
BASE_URL=http://localhost:8000
# Optional bearer token for the JSON API (header X-API-Key)
API_TOKEN=
LOG_LEVEL=INFO

# --- Business identity used in notice text -------------------------------------------------
BUSINESS_NAME=PB4HOST
NOTICE_CONTACT_EMAIL=privacy@pb4host.com

# --- Connectors (all disabled until keys are set and terms reviewed in Admin → Connectors) --
GOOGLE_MAPS_API_KEY=
PSI_API_KEY=
PLACES_REGION_CODE=IN
PLACES_LANGUAGE_CODE=en
PLACES_PAGES_PER_RUN=10
PSI_RUNS=1
PSI_STRATEGIES=["mobile"]

# --- Crawler conduct (R11) -------------------------------------------------------------------
CRAWLER_USER_AGENT=PB4HOST-Prospector/0.1 (+https://www.pb4host.com/prospector; prospector@pb4host.com)
CRAWLER_POLICY_URL=https://www.pb4host.com/prospector
CRAWLER_MIN_INTERVAL_S=1.0
CRAWLER_TIMEOUT_S=10
CRAWLER_MAX_BYTES=2000000
CRAWLER_MAX_PAGES=6
CRAWLER_ACTIVE_PROBES=false
# Never enable in production: lets the probe fetch loopback/private addresses (local spike demos only)
CRAWLER_ALLOW_PRIVATE_HOSTS=false

# --- Phase 2: inbound consent capture --------------------------------------------------------
# Shared secret used by the pb4host.com form handler to sign webhook payloads (HMAC-SHA256).
INBOUND_WEBHOOK_SECRET=
INBOUND_REPLAY_WINDOW_S=300
INBOUND_CONSENT_VERSION=2026-10-v1
PRIVACY_NOTICE_URL=https://www.pb4host.com/privacy
INBOUND_RATE_LIMIT_PER_HOUR=20

# Sign In with LinkedIn (OpenID Connect). Redirect URL to register: ${BASE_URL}/forms/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Legitimate-interest assessment reference recorded on every imported connection
LINKEDIN_CONNECTIONS_LIA_REFERENCE=LIA-2026-01 owner's own LinkedIn connections, 1:1 contact only

# --- Phase 2: enrichment & discovery sources -------------------------------------------------
# Chrome UX Report API (same Google Cloud project as PSI works; falls back to PSI_API_KEY)
CRUX_API_KEY=
# HTTP Archive + CrUX monthly feed: pip install ".[bigquery]", a GCP project with BigQuery enabled and a service account
BIGQUERY_PROJECT=
BIGQUERY_CREDENTIALS_FILE=
HTTPARCHIVE_MAX_BYTES=107374182400
HTTPARCHIVE_DEFAULT_COUNTRY=in
HTTPARCHIVE_DEFAULT_LIMIT=500
# GitHub organisation discovery (fine-grained token, no scopes needed — read-only public data)
GITHUB_TOKEN=
GITHUB_PAGES_PER_RUN=3
# Companies House (UK) — free key from developer.company-information.service.gov.uk
COMPANIES_HOUSE_API_KEY=

# --- Phase 2: CRM sync (EspoCRM) --------------------------------------------------------------
CRM_TARGET=espocrm
# e.g. https://crm.pb4host.com — in docker-compose the bundled instance is http://espocrm
ESPOCRM_BASE_URL=
# API user key: EspoCRM → Administration → API Users (role with Account/Contact create+edit+delete)
ESPOCRM_API_KEY=
CRM_STATUS_FIELD=type
CRM_STATUS_MAP={"Customer": "customer", "Partner": "customer", "Prospect": "contacted", "Dead": "disqualified"}
CRM_PUSH_PERSONS=true

# --- Phase 2: rights requests & tracking -----------------------------------------------------
RIGHTS_DUE_DAYS=30
RECHECK_INTERVAL_DAYS=7
RECHECK_DAILY_LIMIT=200
RECHECK_PSI_AFTER_DAYS=28

# --- Retention (days) ------------------------------------------------------------------------
RETENTION_RAW_DAYS=30
RETENTION_COORDS_DAYS=30
RETENTION_PERF_DAYS=365
RETENTION_UNENGAGED_DAYS=365
RETENTION_PERSON_DAYS=180
RETENTION_JOBS_DAYS=30
TERMS_REVIEW_MAX_AGE_DAYS=90

# --- Scoring context ------------------------------------------------------------------------
LATEST_WORDPRESS_VERSION=6.8
PHP_MIN_SUPPORTED=8.2

# --- docker-compose only --------------------------------------------------------------------
POSTGRES_PASSWORD=
PROSPECTOR_HOST=prospector.example.com
ADMIN_EMAIL=admin@example.com
BACKUP_KEEP_DAYS=14
# Optional bundled EspoCRM (docker compose --profile crm up -d)
CRM_HOST=crm.example.com
ESPOCRM_DB_PASSWORD=
ESPOCRM_ADMIN_PASSWORD=
